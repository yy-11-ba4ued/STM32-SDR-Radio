/* ================= ILI9488 480x320 (3.95") 16bit 并口 =================
 * 驱动方式: GPIO 位带 (非 FMC)。实测 FMC(复用/非复用) 在本接法下送 16 位像素数据不可靠,
 *           而 GPIO 干净单次写脉冲稳定可靠, 故正式驱动改用 GPIO 位带(见 USER CODE 4)。
 *       DB0~DB15 -> PD14,PD15,PD0,PD1,PE7~PE15,PD8,PD9,PD10
 *       WRX      -> PD5   RDX -> PD4   CSX -> PC7
 *       DCX/RS   -> PC0 (GPIO)   RESET -> PC1 (GPIO)
 *       IM[2:0]=010 => 80 并口 16bit (DB15~DB0)
 * ------------------------------------------------------------------ */
#define ILI9488_WIDTH        480   /* 横屏: 逻辑宽 480 (MADCTL=0x68 旋转 90°) */
#define ILI9488_HEIGHT       320   /* 横屏: 逻辑高 320 */
/* FMC Bank1. DCX(PC0) and CS(PC7) by GPIO (same as working GPIO driver).
 * FMC only generates NWE pulse and outputs data. Single address for all writes. */
#define LCD_FMC_ADDR   ((volatile uint16_t *)0x60000000UL)

/* DCX/RS = PC0, RESET = PC1 (CubeMX 已配置为输出) */
#define ILI9488_DCX_PORT     DCX_RS10_GPIO_Port   /* GPIOC */
#define ILI9488_DCX_PIN      DCX_RS10_Pin          /* GPIO_PIN_0 */
#define ILI9488_RST_PORT     RESET15_GPIO_Port     /* GPIOC */
#define ILI9488_RST_PIN      RESET15_Pin           /* GPIO_PIN_1 */

#define ILI9488_DCX_HIGH()   (ILI9488_DCX_PORT->BSRR = (uint32_t)ILI9488_DCX_PIN)
#define ILI9488_DCX_LOW()    (ILI9488_DCX_PORT->BSRR = ((uint32_t)ILI9488_DCX_PIN << 16U))
#define ILI9488_RST_HIGH()   (ILI9488_RST_PORT->BSRR = (uint32_t)ILI9488_RST_PIN)
#define ILI9488_RST_LOW()    (ILI9488_RST_PORT->BSRR = ((uint32_t)ILI9488_RST_PIN << 16U))

/* RGB565 合成 */
#define ILI9488_RGB565(r,g,b) ((((uint16_t)(r) & 0xF8U) << 8) | \
                               (((uint16_t)(g) & 0xFCU) << 3) | \
                               (((uint16_t)(b) & 0xF8U) >> 3))


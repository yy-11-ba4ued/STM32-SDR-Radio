/* 11x16 grayscale AA text, char advance 12, '.' half-width bottom dot */
static void ui_draw_16(uint16_t x, uint16_t y, const char *s, uint16_t color) {
  static const uint8_t num[4] = {0,13,20,24};
  const char *set = " .:+-/()0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz";
  while (*s) {
    if (*s == '.') {
      lcd_draw_pixel(x+2, y+13, color);
      lcd_draw_pixel(x+3, y+13, color);
      lcd_draw_pixel(x+2, y+12, color);
      lcd_draw_pixel(x+3, y+12, color);
      x += 6;
    } else {
      int idx = -1;
      for (int i=0;i<70;i++) if (set[i]==*s){idx=i;break;}
      if (idx>=0) {
        for (int r=0;r<16;r++) {
          uint32_t v=((uint32_t)font11x16[idx][r*3]<<16)|
                     ((uint32_t)font11x16[idx][r*3+1]<<8)|
                     font11x16[idx][r*3+2];
          for (int cc=0;cc<11;cc++) {
            uint8_t lv=(v>>(22-2*cc))&3;
            if (lv) lcd_draw_pixel(x+cc,y+r,aa_blend(color,UI_BG,num[lv],24));
          }
        }
      }
      x += 12;
    }
    s++;
  }
}


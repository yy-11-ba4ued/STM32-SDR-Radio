/* 9x15 grayscale AA text, char advance 10, '.' half-width bottom dot */
static void ui_draw_15(uint16_t x, uint16_t y, const char *s, uint16_t color) {
  static const uint8_t num[4]={0,13,20,24};
  const char *set=" .:+-/()0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz";
  while(*s){
    if(*s=='.'){
      lcd_draw_pixel(x+1,y+12,color); lcd_draw_pixel(x+2,y+12,color);
      lcd_draw_pixel(x+1,y+11,color); lcd_draw_pixel(x+2,y+11,color);
      x+=5;
    } else {
      int idx=-1;
      for(int i=0;i<70;i++) if(set[i]==*s){idx=i;break;}
      if(idx>=0){
        for(int r=0;r<15;r++){
          uint32_t v=((uint32_t)font9x15[idx][r*3]<<16)|
                     ((uint32_t)font9x15[idx][r*3+1]<<8)|
                     font9x15[idx][r*3+2];
          for(int cc=0;cc<9;cc++){
            uint8_t lv=(v>>(22-2*cc))&3;
            if(lv) lcd_draw_pixel(x+cc,y+r,aa_blend(color,UI_BG,num[lv],24));
          }
        }
      }
      x+=10;
    }
    s++;
  }
}

static void ui_draw_static(void)
{
  lcd_clear(UI_BG);

  /* ===== TOP BAR (y=0..55) ===== */
  /* RX box - red rounded rect */
  lcd_fill_rect(6, 4, 72, 50, UI_DARK);
  lcd_fill_rect(6, 4, 72, 5, UI_RED);
  lcd_fill_rect(6, 49, 72, 50, UI_RED);
  lcd_fill_rect(6, 4, 7, 50, UI_RED);
  lcd_fill_rect(71, 4, 72, 50, UI_RED);
  ui_draw_big(11, 6, "RX", UI_WHITE);

  /* PWR / GAIN - small font, tight to RX */
  ui_draw_text(78, 15,  "PWR: 10W", UI_WHITE, 1);
  ui_draw_text(78, 29, "GAIN: +0dB", UI_WHITE, 1);

  /* Sideband indicator (icon x=176, baseline y=34) */
  ui_draw_sideband(176, 43, UI_WHITE, SB_USB);
  /* 3KHz centered above sideband icon (icon center x=196, text 36 wide) */
  ui_draw_text(178, 13, "3KHz", UI_WHITE, 1);

  /* Status circle */
  {
    int cx = 273, cy = 26;
    for (int yy = cy-11; yy <= cy+11; yy++)
      for (int xx = cx-11; xx <= cx+11; xx++) {
        int d = (xx-cx)*(xx-cx) + (yy-cy)*(yy-cy);
        if (d <= 121) lcd_draw_pixel(xx, yy, UI_WHITE);
        if (d <= 64)  lcd_draw_pixel(xx, yy, UI_GREEN);
      }
  }

  /* Temperature */
  ui_draw_text(290, 17, "32C", UI_WHITE, 1);
  lcd_draw_pixel(316, 17, UI_WHITE);
  lcd_draw_pixel(317, 17, UI_WHITE);
  lcd_draw_pixel(316, 18, UI_WHITE);
  lcd_draw_pixel(317, 18, UI_WHITE);

  /* Battery */
  lcd_fill_rect(324, 15, 354, 31, UI_DARK);
  lcd_fill_rect(324, 15, 354, 16, UI_GREY);
  lcd_fill_rect(324, 30, 354, 31, UI_GREY);
  lcd_fill_rect(324, 15, 325, 31, UI_GREY);
  lcd_fill_rect(353, 15, 354, 31, UI_GREY);
  lcd_fill_rect(354, 19, 357, 27, UI_GREY);
  lcd_fill_rect(326, 17, 340, 29, UI_WHITE);
  ui_draw_text(360, 11,  "70", UI_WHITE, 1);
  { static const uint8_t pct[9] = {0x60,0x60,0x08,0x10,0x20,0x40,0x06,0x06,0};
    for (int r=0;r<9;r++) for (int cc=0;cc<8;cc++)
      if (pct[r]&(0x80>>cc)) lcd_draw_pixel(379+cc, 11+r, UI_WHITE); }
  ui_draw_text(359, 22, "12.4v", UI_WHITE, 1);

  /* Current box */
  lcd_fill_rect(405, 15, 476, 39, UI_DARK);
  lcd_fill_rect(405, 15, 476, 16, UI_GREY);
  lcd_fill_rect(405, 38, 476, 39, UI_GREY);
  lcd_fill_rect(405, 15, 406, 39, UI_GREY);
  lcd_fill_rect(475, 15, 476, 39, UI_GREY);
  ui_draw_16(414, 19, "0.52A", UI_WHITE);

  /* ===== FREQUENCY AREA (y=55..115) ===== */

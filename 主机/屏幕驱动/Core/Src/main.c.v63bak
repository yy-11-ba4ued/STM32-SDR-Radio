  lcd_fill_rect(8, 58, 24, 72, UI_DARK);
  lcd_fill_rect(8, 58, 24, 59, UI_GREY);
  lcd_fill_rect(8, 71, 24, 72, UI_GREY);
  lcd_fill_rect(8, 58, 9, 72, UI_GREY);
  lcd_fill_rect(23, 58, 24, 72, UI_GREY);
  lcd_fill_rect(12, 73, 20, 75, UI_GREY);

  /* USB box - centered vertically with frequency */
  lcd_fill_rect(32, 60, 88, 88, UI_DARK);
  lcd_fill_rect(32, 60, 88, 61, UI_WHITE);
  lcd_fill_rect(32, 87, 88, 88, UI_WHITE);
  lcd_fill_rect(32, 60, 33, 88, UI_WHITE);
  lcd_fill_rect(87, 60, 88, 88, UI_WHITE);
  ui_draw_16(42, 66, "USB", UI_WHITE);

  /* Main frequency scale=2 */
  {
    char fbuf[12];
    fmt_freq(ui.vfo_a_hz, fbuf);
    ui_draw_big(95, 56, fbuf, UI_WHITE);
    /* Arrow above the 0 in 270 (3rd group) */
    int ax = 95 + 56 + 14 + 2*28 + 14;
    lcd_fill_rect(ax-4, 55, ax+4, 55, UI_WHITE);
    lcd_fill_rect(ax-2, 56, ax+2, 57, UI_WHITE);
    lcd_fill_rect(ax-1, 58, ax+1, 58, UI_WHITE);
  }

  /* Right status */
  ui_draw_15(360, 56,  "VFO A TX", UI_WHITE);
  ui_draw_15(360, 74,  "XIT +0k",  UI_WHITE);
  ui_draw_15(360, 92,  "VFO A",    UI_WHITE);

  /* ===== METER ROW (y=115..155) ===== */
  ui8_draw_text(31, 120, "S/PWR", UI_WHITE, 1);
  /* S meter bar */
  lcd_fill_rect(95, 122, 205, 135, UI_DARK);
  lcd_fill_rect(95, 122, 205, 123, UI_GREY);
  lcd_fill_rect(95, 134, 205, 135, UI_GREY);
  lcd_fill_rect(95, 122, 96, 135, UI_GREY);
  lcd_fill_rect(204, 122, 205, 135, UI_GREY);
  /* S meter fill (blue + red over) */
  lcd_fill_rect(97, 124, 160, 133, UI_BLUE);
  lcd_fill_rect(160, 124, 170, 133, UI_RED);
  /* Labels */
  ui_draw_text(175, 138, "OVF", UI_RED, 1);
  ui_draw_text(95, 138, "S9+20", UI_YELLOW, 1);
  ui_draw_text(95, 150, "-74dBm", ILI9488_RGB565(0,200,0), 1);

  /* VFO B - same line, white, separated */
  ui_draw_text(200, 100, "7.050", UI_WHITE, 1);
  ui_draw_text(250, 100, "VFO B", UI_WHITE, 1);

  /* SWR */
  ui8_draw_text(235, 120, "SWR", UI_WHITE, 1);
  lcd_fill_rect(275, 122, 385, 135, UI_DARK);
  lcd_fill_rect(275, 122, 385, 123, UI_GREY);
  lcd_fill_rect(275, 134, 385, 135, UI_GREY);
  lcd_fill_rect(275, 122, 276, 135, UI_GREY);
  lcd_fill_rect(384, 122, 385, 135, UI_GREY);
  lcd_fill_rect(277, 124, 310, 133, UI_BLUE);
  lcd_fill_rect(335, 124, 340, 133, UI_RED);
  ui_draw_text(275, 138, "1.0", UI_GREY, 1);
  ui_draw_text(305, 138, "1.5", UI_GREY, 1);
  ui_draw_text(330, 138, "2.0", UI_RED, 1);
  ui_draw_text(355, 138, "3.0", UI_GREY, 1);
  ui_draw_text(360, 150, "HIGH", UI_RED, 1);

  /* ===== SPECTRUM ===== */
  lcd_fill_rect(SP_X0, SP_Y0, SP_X1, SP_Y1, UI_BG);
  lcd_fill_rect(SP_X0, SP_Y0, SP_X1, SP_Y0+1, UI_WHITE);
  lcd_fill_rect(SP_X0, SP_Y1-1, SP_X1, SP_Y1, UI_WHITE);
  lcd_fill_rect(SP_X0, SP_Y0, SP_X0+1, SP_Y1, UI_WHITE);
  lcd_fill_rect(SP_X1-1, SP_Y0, SP_X1, SP_Y1, UI_WHITE);
  /* vertical dB scale removed */

  /* Frequency scale: ticks above axis only, tiny numbers below */
  {
    const char *fr[9] = {"0","75k","150k","225k","300k","375k","450k","525k","600k"};  /* v42: 0-600kHz */
    int sy = SP_Y1 + 3;
    lcd_fill_rect(SP_X0, sy, SP_X1, sy, UI_GREY);
    for (int i = 0; i < 9; i++) {
      int xx = SP_X0 + i * (SP_X1 - SP_X0) / 8;
      lcd_fill_rect(xx, sy-3, xx, sy, UI_GREY);   /* tick above axis only */
      ui_draw_tiny(xx - 9, sy + 1, fr[i], UI_GREY);
    }
  }

  /* ===== WATERFALL ===== */
  lcd_fill_rect(SP_X0, WF_Y0, SP_X1, WF_Y1, UI_BG);
  lcd_fill_rect(SP_X0, WF_Y0, SP_X1, WF_Y0+1, UI_WHITE);
  lcd_fill_rect(SP_X0, WF_Y1-1, SP_X1, WF_Y1, UI_WHITE);
  lcd_fill_rect(SP_X0, WF_Y0, SP_X0+1, WF_Y1, UI_WHITE);
  lcd_fill_rect(SP_X1-1, WF_Y0, SP_X1, WF_Y1, UI_WHITE);
}

/* 灰度查找表: v=0..255 -> RGB565 */
static uint16_t gray_lut[256];
static void gray_lut_init(void) {
  /* Classic SDR waterfall sampled from UIexample:
     black -> deep blue -> red -> orange -> yellow -> green(peak) */
  static const uint8_t sr[6] = {  0,   0, 248, 248, 255, 120};
  static const uint8_t sg[6] = {  0,   0,   0, 140, 255, 252};
  static const uint8_t sb[6] = {  8, 169,   0,   0,   0, 108};
  static const uint8_t sp[6] = {  0,  35,  85, 150, 205, 255};
  for (int i = 0; i < 256; i++) {
    int k = 0;
    while (k < 4 && i > sp[k+1]) k++;
    int span = sp[k+1] - sp[k];
    int f = span ? (i - sp[k]) * 255 / span : 0;
    uint8_t r = (uint8_t)((sr[k]*(255-f) + sr[k+1]*f) / 255);
    uint8_t g = (uint8_t)((sg[k]*(255-f) + sg[k+1]*f) / 255);
    uint8_t b = (uint8_t)((sb[k]*(255-f) + sb[k+1]*f) / 255);
    gray_lut[i] = ILI9488_RGB565(r, g, b);
  }
}


/* ==================== Dynamic field refresh (demo) ==================== */
static void ui_draw_pct(int x, int y, uint16_t color) {
  static const uint8_t pct[9] = {0x60,0x60,0x08,0x10,0x20,0x40,0x06,0x06,0};
  for (int r=0;r<9;r++) for (int cc=0;cc<8;cc++)
    if (pct[r]&(0x80>>cc)) lcd_draw_pixel(x+cc,y+r,color);
}

static void ui_draw_status_circle(int cx, int cy, uint16_t col) {
  lcd_fill_rect(cx-12, cy-12, cx+12, cy+12, UI_BG);
  for (int yy=cy-11; yy<=cy+11; yy++)
    for (int xx=cx-11; xx<=cx+11; xx++) {
      int d=(xx-cx)*(xx-cx)+(yy-cy)*(yy-cy);
      if (d<=121) lcd_draw_pixel(xx,yy,UI_WHITE);
      if (d<=64)  lcd_draw_pixel(xx,yy,col);
    }
}

static void ui_update_dynamic(uint32_t now) {
  char b[24];

  /* ---- simulated values ---- */
  uint8_t step = (now / 300) % 100;
  /* RX/TX toggle every ~1.5s */
  uint8_t tx = ((now / 1500) % 2);
  ui.rx_mode = tx;
  if (tx) ui.pwr_w = 5 + (ui_rand() % 46); else ui.pwr_w = 0;
  ui.gain_db = (int8_t)((step % 21) - 5);
  ui.temp_c = 28 + (step % 8);
  ui.batt_pct = (uint8_t)(20 + (step * 80 / 100));   /* sweep 20..100 */
  ui.bat_v = (uint16_t)(118 + (step % 18));          /* 11.8..13.5 V */
  ui.cur_100ma = (uint16_t)(30 + (ui_rand() % 60));  /* 0.30..0.90 A */
  ui.vfo_a_hz = 14270000 + ((int)step - 50) * 100;
  ui.vfo_b_hz = 7050000  + ((int)step - 50) * 50;
  ui.xit_khz = (int16_t)(((step % 7) - 3));
  ui.swr_val = (uint16_t)(11 + (ui_rand() % 16));    /* 1.1..2.6 */
  ui.status = (now / 2000) % 3;                      /* green/yellow/red */

  /* ---- TX/RX big ---- */
  lcd_fill_rect(8, 6, 70, 48, UI_DARK);
  ui_draw_big(11, 6, tx ? "TX" : "RX", tx ? UI_RED : UI_WHITE);

  /* ---- PWR / GAIN ---- */
  lcd_fill_rect(78, 14, 176, 28, UI_BG);
  snprintf(b, sizeof b, "PWR: %dW", ui.pwr_w);
  ui_draw_text(78, 15, b, UI_WHITE, 1);
  lcd_fill_rect(78, 28, 176, 42, UI_BG);
  snprintf(b, sizeof b, "GAIN: %+ddB", (int)ui.gain_db);
  ui_draw_text(78, 29, b, UI_WHITE, 1);

  /* ---- bandwidth above sideband ---- */
  {
    static const char *bw[3] = {"1.2KHz","2.4KHz","3KHz"};
    const char *s = bw[(now/900)%3];
    lcd_fill_rect(174, 12, 228, 26, UI_BG);
    ui_draw_text(176, 13, s, UI_WHITE, 1);
  }

  /* ---- status circle ---- */
  {
    uint16_t cols[3] = { UI_GREEN, UI_YELLOW, UI_RED };
    ui_draw_status_circle(273, 26, cols[ui.status]);
  }

  /* ---- temperature ---- */
  lcd_fill_rect(290, 16, 321, 30, UI_BG);
  snprintf(b, sizeof b, "%dC", ui.temp_c);
  ui_draw_text(290, 17, b, UI_WHITE, 1);
  lcd_draw_pixel(316,17,UI_WHITE); lcd_draw_pixel(317,17,UI_WHITE);
  lcd_draw_pixel(316,18,UI_WHITE); lcd_draw_pixel(317,18,UI_WHITE);

  /* ---- battery fill (proportional) ---- */
  {
    uint8_t w = (uint8_t)(27 * ui.batt_pct / 100);
    lcd_fill_rect(326, 17, 352, 29, UI_DARK);
    if (w) lcd_fill_rect(326, 17, 326 + w - 1, 29, UI_WHITE);
  }
  /* ---- battery percent + voltage ---- */
  lcd_fill_rect(359, 10, 401, 35, UI_BG);
  snprintf(b, sizeof b, "%d", ui.batt_pct);
  ui_draw_text(360, 11, b, UI_WHITE, 1);
  {
    int nd = 0; uint8_t v = ui.batt_pct; if(v==0) nd=1; while(v){nd++;v/=10;}
    ui_draw_pct(360 + nd*9, 11, UI_WHITE);
  }
  snprintf(b, sizeof b, "%d.%dv", ui.bat_v/10, ui.bat_v%10);
  ui_draw_text(359, 22, b, UI_WHITE, 1);

  /* ---- current in box ---- */
  lcd_fill_rect(407, 17, 474, 37, UI_DARK);
  snprintf(b, sizeof b, "%d.%02dA", ui.cur_100ma/100, ui.cur_100ma%100);
  ui_draw_16(414, 19, b, UI_WHITE);

  /* ---- main frequency + arrow ---- */
  lcd_fill_rect(94, 54, 350, 99, UI_BG);
  {
    char fbuf[12];
    fmt_freq(ui.vfo_a_hz, fbuf);
    ui_draw_big(95, 56, fbuf, UI_WHITE);
    int ax = 95 + 56 + 14 + 2*28 + 14;
    lcd_fill_rect(ax-4, 55, ax+4, 55, UI_WHITE);
    lcd_fill_rect(ax-2, 56, ax+2, 57, UI_WHITE);
    lcd_fill_rect(ax-1, 58, ax+1, 58, UI_WHITE);
  }

  /* ---- right three lines ---- */
  lcd_fill_rect(360, 55, 448, 108, UI_BG);
  ui_draw_15(360, 56, tx ? "VFO A TX" : "VFO A RX", UI_WHITE);
  snprintf(b, sizeof b, "XIT %+dk", (int)ui.xit_khz);
  ui_draw_15(360, 74, b, UI_WHITE);
  ui_draw_15(360, 92, "VFO A", UI_WHITE);

  /* ---- VFO B ---- */
  lcd_fill_rect(200, 100, 320, 113, UI_BG);
  snprintf(b, sizeof b, "%d.%03d", ui.vfo_b_hz/1000000, (ui.vfo_b_hz/1000)%1000);
  ui_draw_text(200, 100, b, UI_WHITE, 1);
  ui_draw_text(250, 100, "VFO B", UI_WHITE, 1);

  /* ---- SWR meter fill (1.0..3.0 -> 0..106px) ---- */
  {
    int f = ui.swr_val - 10; if (f < 0) f = 0; if (f > 20) f = 20;
    int w = f * 106 / 20;
    lcd_fill_rect(277, 124, 383, 133, UI_DARK);
    if (w) lcd_fill_rect(277, 124, 277 + w - 1, 133,
                         (ui.swr_val >= 20) ? UI_RED : UI_BLUE);
  }
}

void ui_main(void)
{
  static uint8_t wf_buf[WF_H][SP_W];
  static uint8_t wf_row = 0;
  static uint8_t col_intensity[SP_W];
  static int16_t rx_spec[2048];   /* raw IQ frame from slave via SPI3 */
  static uint8_t rx_hdr[5];       /* frame header AA 5A seq len_lo len_hi */
  memset(wf_buf, 0, sizeof(wf_buf));

  gray_lut_init();
  ui_draw_static();

  uint16_t last_s = 0xFFFF;
  uint16_t last_swr = 0xFFFF;

  /* FPS counter */
  static uint32_t fps_count = 0;
  static uint32_t fps_last_t = 0;
  static uint8_t fps_val = 0;

  /* 初始画一次 S 表和 SWR 表进度条 */
  {
    uint16_t s_w = ui.s_level * 106 / 100;
    lcd_fill_rect(97, 124, 97+s_w, 133, UI_BLUE);
    last_s = ui.s_level;
  }

  while (1) {
    uint32_t t0 = HAL_GetTick();

    /* ---- slow dynamic fields (~300ms) ---- */
    {
      static uint32_t dyn_timer = 0;
      if (t0 - dyn_timer >= 300) { dyn_timer = t0; ui_update_dynamic(t0); }
    }

    /* ---- Sideband mode cycling demo: USB -> LSB -> DSB every 900ms ---- */
    {
      static uint32_t sb_timer = 0;
      static int sb_mode = SB_USB;
      if (t0 - sb_timer >= 900) {
        sb_timer = t0;
        sb_mode = (sb_mode + 1) % 3;
        lcd_fill_rect(176, 27, 217, 43, UI_BG);        /* clear icon footprint */
        ui_draw_sideband(176, 43, UI_WHITE, sb_mode);
      }
    }

    /* v46: 12fps 显示节拍(83ms) —— 频谱/进度条/SPI 读帧统一降频, 要延时小而非高刷新率 */
    static uint32_t sp_draw_t = 0;
    /* 虚拟数据 (v46: 节拍内更新, 防进度条高速跳动) */
    if (HAL_GetTick() - sp_draw_t >= 83) ui.s_level = 40 + (ui_rand() % 25);

    /* S 表进度条: 只在值变化时才重画 */
    if (ui.s_level != last_s) {
      uint16_t old_w = last_s * 106 / 100;
      uint16_t new_w = ui.s_level * 106 / 100;
      /* 只画变化的部分 */
      if (new_w > old_w)
        lcd_fill_rect(97+old_w, 124, 97+new_w, 133, new_w>150 ? UI_RED : UI_BLUE);
      else
        lcd_fill_rect(97+new_w, 124, 97+old_w, 133, UI_DARK);
      last_s = ui.s_level;
    }

    /* ---- Read one raw IQ frame from slave over SPI3, FFT on host ---- */
    /* v47: 读帧移到节拍外(每轮) —— NSS 每秒 ~135 次拉低、数据占会话 ~60%,
     * 帧始终最新; 仅 FFT/重绘 12fps(83ms) 限频(显示延时 83ms 内)。 */
    static uint32_t nofrm_cnt = 0;   /* v44: 连续无帧轮计数(>=4 判定从机掉线) */
    static int16_t sp_frame[FFT_N];  /* v47: 最新帧暂存(每轮覆盖) */
    uint8_t sp_got = spi_rx_frame(rx_hdr, (uint8_t*)sp_frame, sizeof(sp_frame));
    if (sp_got) { nofrm_cnt = 0; }
    else nofrm_cnt++;
    if (HAL_GetTick() - sp_draw_t >= 83) {   /* v47: 仅 FFT/重绘限频 */
      sp_draw_t = HAL_GetTick();
      if (nofrm_cnt == 0) {
      /* v59: 简化 SPI 状态框(在跑即可)。v51-v58 的坏帧/泄漏计数与取证打印
       * 全部移除 —— 泄漏根治后不再需要, 频谱每帧直接刷新。 */
      static uint8_t last_seq = 0xFF;
      if (rx_hdr[2] != last_seq) {
        char dbg[24];
        snprintf(dbg, sizeof(dbg), "SPI OK s%u", rx_hdr[2]);
        lcd_fill_rect(100, 100, 380, 130, UI_BG);
        ui_draw_text(110, 120, dbg, UI_GREEN, 1);
        last_seq = rx_hdr[2];
      }
      fft_apply(sp_frame, col_intensity, SP_W);
    } else {
      /* v44: 无帧保持上一帧频谱(不画底噪); NO FRAME 提示仅在连续 >=4 轮无帧时显示。
       * v47: nofrm_cnt 已移到节拍外每轮计数(见上), 此处仅提示判定。 */
      static uint32_t nofrm_t = 0;
      if (nofrm_cnt >= 4 && (HAL_GetTick() - nofrm_t >= 300)) {
        nofrm_t = HAL_GetTick();
        lcd_fill_rect(100, 100, 380, 130, UI_BG);
        ui_draw_text(110, 120, "NO FRAME", UI_RED, 1);
        /* v36 诊断: 显示本次读到内容 (帮助定位主机读到的是垃圾/错位/真数据) */
        uint32_t _aa = 0, _ff = 0;
        for (uint32_t _k = 0; _k < sizeof(spi_scan); _k++) {
          if (spi_scan[_k] == 0xAA) _aa++;
          else if (spi_scan[_k] == 0xFF) _ff++;
        }
        /* v37: 两行紧凑, 一行放不下 */
        char diag1[24], diag2[16];
        snprintf(diag1, sizeof(diag1), "%02X%02X%02X%02X%02X%02X%02X%02X",
                 spi_scan[0], spi_scan[1], spi_scan[2], spi_scan[3],
                 spi_scan[4], spi_scan[5], spi_scan[6], spi_scan[7]);
        snprintf(diag2, sizeof(diag2), "A:%lu F:%lu",
                 (unsigned long)_aa, (unsigned long)_ff);
        ui8_draw_text(110, 102, diag1, UI_YELLOW, 1);
        ui8_draw_text(110, 112, diag2, UI_YELLOW, 1);
      }
      /* v44: 不覆盖 col_intensity —— 保持上一帧频谱(见上) */
    }

    /* ---- 频谱: 白色柱(亮度随强度, 255 级), 铺满整个框, 批量写入 ---- */
    if (nofrm_cnt == 0) {   /* v59: 有帧即刷新(泄漏检测已移除) */
      static uint8_t wf_lut_ok = 0;
      if (!wf_lut_ok) { wf_color_lut_init(); sp_col_lut_init(); wf_lut_ok = 1; }
      int sp_h = SP_Y1 - SP_DY0;     /* compressed bar height inside frame */
      int sp_w = SP_W - 2;
      lcd_set_window(SP_X0+1, SP_DY0, SP_X1-1, SP_Y1-1);
      lcd_cmd(0x2C);
      ILI9488_DCX_HIGH();
      uint16_t black = 0x0000;
      for (int y = 0; y < sp_h; y++) {
        for (int x = 0; x < sp_w; x++) {
          int bar_top = sp_h - (col_intensity[x] * sp_h / 255);
          lcd_write16((y >= bar_top) ? sp_col_lut[col_intensity[x]] : black);   /* v62: 频谱柱白色(瀑布才彩色) */
        }
      }
    }
    }   /* v46: 12fps 节拍结束 */

    /* ---- v42: 纵轴 dBm 刻度(顶0 / 中-40 / 底-76 dBm), 每帧重画保持可见 ---- */
    {
      const char *db_lab[3] = {"0dB", "-40", "-80"};   /* v61: 满量程刻度(0dB=1V, 动态80dB) */
      for (int i = 0; i < 3; i++) {
        int yy;
        if (i == 0)      yy = SP_Y0 + 3;                                  /* 0dB=1V 满量程 顶部 */
        else if (i == 1) yy = SP_Y1 - 40 * (SP_Y1 - SP_Y0) / 80 - 6;      /* -40dB 中 */
        else             yy = SP_Y1 - 16;                                 /* -80dB 底部 */
        lcd_fill_rect(SP_X0 + 1, yy + 6, SP_X0 + 8, yy + 6, UI_GREY);     /* 短刻度线 */
        ui_draw_tiny(SP_X0 + 2, yy, db_lab[i], UI_GREY);
      }
    }

    /* ---- 瀑布图: 灰度, 批量写入 ---- */
    {
      /* 新一行强度 (和频谱同形状) */
      for (int x = 0; x < SP_W; x++)
        wf_buf[wf_row][x] = col_intensity[x];      /* v60: 0..255 直接用(彩色 LUT 索引) */

      int wf_h = WF_H - 2;
      int wf_w = SP_W - 2;
      lcd_set_window(SP_X0+1, WF_Y0+1, SP_X1-1, WF_Y1-1);
      lcd_cmd(0x2C);
      ILI9488_DCX_HIGH();
      for (int y = 0; y < wf_h; y++) {
        int src_row = (wf_row + WF_H - y) % WF_H;
        for (int x = 0; x < wf_w; x++)
          lcd_write16(wf_col_lut[wf_buf[src_row][x]]);   /* v60: 灰度->RGB565 全色域渐变 */
      }
      wf_row = (wf_row + 1) % WF_H;
    }

    extern void ui_designer_process(void);
    /* Process UI designer commands */
    ui_designer_process();

    /* 帧率限制 ~25fps */
    uint32_t el = HAL_GetTick() - t0;
    if (el < 40) HAL_Delay(40 - el);

    /* FPS counter */
    fps_count++;
    uint32_t now = HAL_GetTick();
    if (now - fps_last_t >= 1000) {
      fps_val = fps_count * 1000 / (now - fps_last_t);
      fps_count = 0;
      fps_last_t = now;
      /* on-screen FPS removed (overlaps spectrum) */ (void)fps_val;
    }
  }
}

/* ==================== ILI9488 GPIO 位带驱动 (正式版) ====================
 * 实测结论: 屏和杜邦线都正常; FMC(复用/非复用)在本接法下送 16 位像素数据不可靠,
 *           而 GPIO 位带(干净单次写脉冲)稳定可靠。故正式驱动改用 GPIO 位带,
 *           用位运算一次铺满 16 位数据, 默认速度 ~1.8MHz (比诊断版快 13 倍)。
 * 引脚: D0=PD14,D1=PD15,D2=PD0,D3=PD1, D4~D12=PE7~PE15, D13=PD8,D14=PD9,D15=PD10
 *       WR=PD5, RD=PD4, CS=PC7, DCX=PC0, RESET=PC1
 * 时序: 数据建立 -> WR低 -> WR高(上升沿锁存)。CS 常低, RD 常高。
 * 速度调节: 改 LCD_DLY。默认 1(全速); 花屏/闪就调大 2/3/4。
 */
#define LCD_DLY   3   /* 每段延时 NOP 数: 1=快速, 0=最快; 花屏/闪则调大 2/3/4 */

#define LCD_PD_DATA_MASK  0xC703UL  /* PD0,1,8,9,10,14,15 */
#define LCD_PE_DATA_MASK  0xFF80UL  /* PE7~PE15 */
#define LCD_WR_PIN        GPIO_PIN_5   /* PD5 */
#define LCD_RD_PIN        GPIO_PIN_4   /* PD4 */
#define LCD_CS_PIN        GPIO_PIN_7   /* PC7 */

static inline void lcd_delay(uint32_t n)
{
  while (n--) { __NOP(); }   /* 非 volatile: 常量 n 在编译期展开为固定 NOP, 无内存往返 */
}

/* 16 位数据一次铺到两个 GPIO 口 (位运算, 无循环) */
static inline void lcd_set_data(uint16_t v)
{
  GPIOD->ODR = (GPIOD->ODR & ~LCD_PD_DATA_MASK)
             | (((v & 0x0003U) << 14) | ((v & 0x000CU) >> 2) | ((v & 0xE000U) >> 5));
  GPIOE->ODR = (GPIOE->ODR & ~LCD_PE_DATA_MASK)
             | ((v & 0x0FF0U) << 3);
}


/* 只配置 DCX(PC0) 和 RESET(PC1) 为 GPIO; FMC 数据/控制脚保持 MX_FMC_Init 的 AF 配置 */
static void lcd_pins_init(void)
{
  GPIO_InitTypeDef g = {0};
  g.Mode = GPIO_MODE_OUTPUT_PP;
  g.Pull = GPIO_NOPULL;
  g.Speed = GPIO_SPEED_FREQ_VERY_HIGH;

  /* PC0 = DCX (GPIO output), PC1 = RESET (GPIO output), PC7 = CS (GPIO output, ALWAYS LOW)
   * Same as working GPIO bit-bang driver! FMC only controls NWE(PD5) and data lines. */
  g.Pin = GPIO_PIN_0|GPIO_PIN_1|GPIO_PIN_7;
  HAL_GPIO_Init(GPIOC, &g);
  HAL_GPIO_WritePin(GPIOC, GPIO_PIN_0, GPIO_PIN_SET);    /* DCX high */
  HAL_GPIO_WritePin(GPIOC, GPIO_PIN_1, GPIO_PIN_SET);    /* RESET high */
  HAL_GPIO_WritePin(GPIOC, GPIO_PIN_7, GPIO_PIN_RESET);  /* CS always LOW */

  /* PD4=RD(AF12), PD5=WR(AF12), PD/PE=data(AF12) stay as FMC AF from MX_FMC_Init */

  /* FMC timing: Mode A, conservative */
  {
    volatile uint32_t *bcr1 = (volatile uint32_t *)0x52004000UL;
    volatile uint32_t *btr1 = (volatile uint32_t *)0x52004004UL;
    uint32_t bcr1_val = *bcr1;
    *bcr1 = bcr1_val & ~1UL;  /* MBKEN=0 */
    __DSB();
    *btr1 = 0x00030812;   /* Mode A fastest: ADDSET=0, ADDHLD=1, DATAST=3, BUSTURN=0 */
    __DSB();
    *bcr1 = bcr1_val;     /* Re-enable */
    __DSB();
  }
}

static void lcd_reset(void)
{
  ILI9488_RST_HIGH(); HAL_Delay(10);
  ILI9488_RST_LOW();  HAL_Delay(20);
  ILI9488_RST_HIGH(); HAL_Delay(120);
}

/* 初始化: 480x320 (横屏) / RGB565 / BGR */
void lcd_init(void)
{
  static const uint16_t pgam[15] = {0x00,0x03,0x09,0x08,0x16,0x0A,0x3F,0x78,0x4C,0x09,0x0A,0x08,0x16,0x1A,0x0F};
  static const uint16_t ngam[15] = {0x00,0x16,0x19,0x03,0x0F,0x05,0x32,0x45,0x46,0x04,0x0E,0x0D,0x35,0x37,0x0F};
  static const uint16_t pw1[2]   = {0x17,0x15};
  static const uint16_t pw2[1]   = {0x41};
  static const uint16_t vcom[3]  = {0x00,0x12,0x80};
  static const uint16_t mad[1]   = {0xE8}; /* MADCTL: MV|MY|MX|BGR = 横屏 480x320 (在 0x28 基础上再旋转 180°) */
  static const uint16_t col[1]   = {0x55};
  static const uint16_t ifm[1]   = {0x00};
  static const uint16_t frc[1]   = {0xA0};
  static const uint16_t inv[1]   = {0x02};
  static const uint16_t dfc[3]   = {0x02,0x02,0x3B};
  static const uint16_t emc[1]   = {0xC6};
  static const uint16_t adj[4]   = {0xA9,0x51,0x2C,0x82};

  lcd_pins_init();
  lcd_reset();
  HAL_Delay(50);
  lcd_cmd_params(0xE0, pgam, 15); HAL_Delay(5);
  lcd_cmd_params(0xE1, ngam, 15); HAL_Delay(5);
  lcd_cmd_params(0xC0, pw1, 2);  HAL_Delay(5);
  lcd_cmd_params(0xC1, pw2, 1);  HAL_Delay(5);
  lcd_cmd_params(0xC5, vcom, 3); HAL_Delay(5);
  lcd_cmd_params(0x36, mad, 1);  HAL_Delay(5);
  lcd_cmd_params(0x3A, col, 1);  HAL_Delay(5);
  lcd_cmd_params(0xB0, ifm, 1);  HAL_Delay(5);
  lcd_cmd_params(0xB1, frc, 1);  HAL_Delay(5);
  lcd_cmd_params(0xB4, inv, 1);  HAL_Delay(5);
  lcd_cmd_params(0xB6, dfc, 3);  HAL_Delay(5);
  lcd_cmd_params(0xB7, emc, 1);  HAL_Delay(5);
  lcd_cmd_params(0xF7, adj, 4);  HAL_Delay(5);
  lcd_cmd(0x11); HAL_Delay(120);
  lcd_cmd(0x29); HAL_Delay(50);
  HAL_Delay(50);
}

/* Debug: print FMC and GPIO status, then try GPIO bit-bang write to verify hardware */
static void lcd_debug_print(void)
{
  char buf[256];
  int n;
  uint32_t bcr1 = *(volatile uint32_t *)0x52004000UL;
  uint32_t btr1 = *(volatile uint32_t *)0x52004004UL;
  uint32_t sr1  = *(volatile uint32_t *)0x52004040UL;
  uint32_t ahb3enr = RCC->AHB3ENR;
  n = snprintf(buf, sizeof buf, "DBG FMC BCR1=0x%08lX BTR1=0x%08lX SR1=0x%08lX\r\n",
      (unsigned long)bcr1, (unsigned long)btr1, (unsigned long)sr1);
  HAL_UART_Transmit(&huart2, (uint8_t *)buf, n, 100);
  n = snprintf(buf, sizeof buf, "DBG RCC AHB3ENR=0x%08lX\r\n", (unsigned long)ahb3enr);
  HAL_UART_Transmit(&huart2, (uint8_t *)buf, n, 100);
  n = snprintf(buf, sizeof buf, "DBG GPIOD MODER=0x%08lX AFRH=0x%08lX AFRL=0x%08lX\r\n",
      (unsigned long)GPIOD->MODER, (unsigned long)GPIOD->AFR[1], (unsigned long)GPIOD->AFR[0]);
  HAL_UART_Transmit(&huart2, (uint8_t *)buf, n, 100);
  n = snprintf(buf, sizeof buf, "DBG GPIOE MODER=0x%08lX AFRH=0x%08lX\r\n",
      (unsigned long)GPIOE->MODER, (unsigned long)GPIOE->AFR[1]);
  HAL_UART_Transmit(&huart2, (uint8_t *)buf, n, 100);
  n = snprintf(buf, sizeof buf, "DBG GPIOC MODER=0x%08lX AFRL=0x%08lX\r\n",
      (unsigned long)GPIOC->MODER, (unsigned long)GPIOC->AFR[0]);
  HAL_UART_Transmit(&huart2, (uint8_t *)buf, n, 100);

  /* Try FMC write and capture NWE/NE1 */
  n = snprintf(buf, sizeof buf, "DBG before FMC write\r\n");
  HAL_UART_Transmit(&huart2, (uint8_t *)buf, n, 100);
  {
    uint32_t pd5_hist[64] = {0};
    uint32_t pc7_hist[64] = {0};
    /* Capture during FMC write */
    for(int i=0;i<64;i++) {
      pd5_hist[i] = (GPIOD->IDR >> 5) & 1;
      pc7_hist[i] = (GPIOC->IDR >> 7) & 1;
      if(i == 30) { *LCD_FMC_ADDR = 0xAA55; __DSB(); }
    }
    /* Print capture */
    n = snprintf(buf, sizeof buf, "DBG NWE:");
    HAL_UART_Transmit(&huart2, (uint8_t *)buf, n, 100);
    for(int i=0;i<64;i++) { buf[0] = pd5_hist[i] ? '1' : '0'; HAL_UART_Transmit(&huart2, (uint8_t *)buf, 1, 100); }
    n = snprintf(buf, sizeof buf, "\r\nDBG NE1:");
    HAL_UART_Transmit(&huart2, (uint8_t *)buf, n, 100);
    for(int i=0;i<64;i++) { buf[0] = pc7_hist[i] ? '1' : '0'; HAL_UART_Transmit(&huart2, (uint8_t *)buf, 1, 100); }
    n = snprintf(buf, sizeof buf, "\r\n");
    HAL_UART_Transmit(&huart2, (uint8_t *)buf, n, 100);
  }
  n = snprintf(buf, sizeof buf, "DBG after FMC write\r\n");
  HAL_UART_Transmit(&huart2, (uint8_t *)buf, n, 100);

  /* Now try GPIO bit-bang write to verify hardware works */
  n = snprintf(buf, sizeof buf, "DBG trying GPIO bit-bang write\r\n");
  HAL_UART_Transmit(&huart2, (uint8_t *)buf, n, 100);

  /* Save current AF config */
  uint32_t pd_moder = GPIOD->MODER;
  uint32_t pe_moder = GPIOE->MODER;
  uint32_t pc_moder = GPIOC->MODER;

  /* Switch data pins and control pins to GPIO output */
  GPIOD->MODER = (GPIOD->MODER & ~0xAFEAFAFA) | 0x55155555;  /* PD0,1,4,5,8,9,10,14,15 = output */
  GPIOE->MODER = (GPIOE->MODER & ~0xAAAABFFF) | 0x55554000;  /* PE7-15 = output */
  GPIOC->MODER = (GPIOC->MODER & ~0x0000C000) | 0x00004000;  /* PC7 = output */
  __DSB();

  /* CS low, RD high, WR high */
  GPIOC->BSRR = (uint32_t)GPIO_PIN_7 << 16;  /* CS low */
  GPIOD->BSRR = (uint32_t)GPIO_PIN_4;         /* RD high */
  GPIOD->BSRR = (uint32_t)GPIO_PIN_5;         /* WR high */

  /* Write 0xAA55 via GPIO bit-bang */
  uint16_t v = 0xAA55;
  GPIOD->ODR = (GPIOD->ODR & ~0xC703) | (((v & 0x0003U) << 14) | ((v & 0x000CU) >> 2) | ((v & 0xE000U) >> 5));
  GPIOE->ODR = (GPIOE->ODR & ~0xFF80) | ((v & 0x0FF0U) << 3);
  for(volatile int i=0;i<20;i++) __NOP();  /* data setup */
  GPIOD->BSRR = (uint32_t)GPIO_PIN_5 << 16;  /* WR low */
  for(volatile int i=0;i<20;i++) __NOP();
  GPIOD->BSRR = (uint32_t)GPIO_PIN_5;         /* WR high */
  for(volatile int i=0;i<20;i++) __NOP();

  n = snprintf(buf, sizeof buf, "DBG GPIO bit-bang write done\r\n");
  HAL_UART_Transmit(&huart2, (uint8_t *)buf, n, 100);

  /* Restore AF config */
  GPIOD->MODER = pd_moder;
  GPIOE->MODER = pe_moder;
  GPIOC->MODER = pc_moder;
  __DSB();

  n = snprintf(buf, sizeof buf, "DBG pins restored to AF\r\n");
  HAL_UART_Transmit(&huart2, (uint8_t *)buf, n, 100);
}

/* 设定写入窗口 */
static void lcd_set_window(uint16_t x0, uint16_t y0, uint16_t x1, uint16_t y1)
{
  lcd_cmd(0x2A);
  lcd_data(x0 >> 8); lcd_data(x0 & 0xFF); lcd_data(x1 >> 8); lcd_data(x1 & 0xFF);
  lcd_cmd(0x2B);
  lcd_data(y0 >> 8); lcd_data(y0 & 0xFF); lcd_data(y1 >> 8); lcd_data(y1 & 0xFF);
}

/* 填充矩形 */
void lcd_fill_rect(uint16_t x0, uint16_t y0, uint16_t x1, uint16_t y1, uint16_t color)
{
  uint32_t i, n;
  uint16_t t;
  if (x0 > x1) { t = x0; x0 = x1; x1 = t; }
  if (y0 > y1) { t = y0; y0 = y1; y1 = t; }
  lcd_set_window(x0, y0, x1, y1);
  lcd_cmd(0x2C);
  ILI9488_DCX_HIGH();
  n = (uint32_t)(x1 - x0 + 1U) * (uint32_t)(y1 - y0 + 1U);
  for (i = 0; i < n; i++) lcd_write16(color);
}

/* 清屏 */
void lcd_clear(uint16_t color) { lcd_fill_rect(0, 0, ILI9488_WIDTH - 1, ILI9488_HEIGHT - 1, color); }

/* 单像素 */
void lcd_draw_pixel(uint16_t x, uint16_t y, uint16_t color) { lcd_fill_rect(x, y, x, y, color); }

/* 演示: 验证颜色/坐标/速度 (死循环) */
void lcd_demo(void)
{
  uint16_t i, x, y;

  while (1)
  {
    /* ① 整屏纯色: 验证颜色 */
    lcd_clear(ILI9488_RGB565(255,0,0));   HAL_Delay(1500);
    lcd_clear(ILI9488_RGB565(0,255,0));   HAL_Delay(1500);
    lcd_clear(ILI9488_RGB565(0,0,255));   HAL_Delay(1500);
    lcd_clear(ILI9488_RGB565(255,255,255)); HAL_Delay(1500);
    lcd_clear(ILI9488_RGB565(0,0,0));     HAL_Delay(1500);

    /* ② 8 段彩条 */
    {
      static const uint16_t cols[8] = {
        ILI9488_RGB565(255,0,0), ILI9488_RGB565(0,255,0), ILI9488_RGB565(0,0,255),
        ILI9488_RGB565(255,255,0), ILI9488_RGB565(0,255,255), ILI9488_RGB565(255,0,255),
        ILI9488_RGB565(255,255,255), ILI9488_RGB565(0,0,0) };
      uint16_t seg = ILI9488_WIDTH / 8;
      for (i = 0; i < 8; i++)
        lcd_fill_rect(i * seg, 0, (i == 7) ? (ILI9488_WIDTH - 1) : (i * seg + seg - 1), ILI9488_HEIGHT - 1, cols[i]);
    }
    HAL_Delay(2000);

    /* ③ 网格 */
    lcd_clear(ILI9488_RGB565(10,10,10));
    for (x = 0; x < ILI9488_WIDTH; x += 40) lcd_fill_rect(x, 0, x, ILI9488_HEIGHT - 1, ILI9488_RGB565(0,255,0));
    for (y = 0; y < ILI9488_HEIGHT; y += 40) lcd_fill_rect(0, y, ILI9488_WIDTH - 1, y, ILI9488_RGB565(0,255,0));
    HAL_Delay(2000);

    /* ④ 棋盘格 */
    for (y = 0; y < ILI9488_HEIGHT; y += 40)
      for (x = 0; x < ILI9488_WIDTH; x += 40)
        lcd_fill_rect(x, y, (x+39 < ILI9488_WIDTH) ? (x+39) : (ILI9488_WIDTH-1),
                          (y+39 < ILI9488_HEIGHT) ? (y+39) : (ILI9488_HEIGHT-1),
                          (((x/40)+(y/40)) & 1) ? ILI9488_RGB565(255,255,255) : ILI9488_RGB565(0,0,0));
    HAL_Delay(2000);

    /* ⑤ 运动白条 (验证速度: 应看到平滑移动) */
    for (x = 0; x + 32 <= ILI9488_WIDTH; x += 32)
    {
      lcd_clear(ILI9488_RGB565(0,0,64));
      lcd_fill_rect(x, 200, x + 31, 279, ILI9488_RGB565(255,255,255));
      HAL_Delay(30);
    }
  }
}





/* Tiny 6x9 text renderer, each char 7px wide, '.' half-width */
static void ui_draw_tiny(uint16_t x, uint16_t y, const char *s, uint16_t color) {
  while (*s) {
    if (*s == '.') {
      lcd_fill_rect(x, y+7, x+1, y+8, color);
      x += 3;
    } else {
      int idx = -1;
      for (int i = 0; i < 70; i++)
        if (" .:+-/()0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"[i] == *s) { idx=i; break; }
      if (idx >= 0)
        for (int r = 0; r < 9; r++)
          for (int cc = 0; cc < 6; cc++)
            if (font6x9[idx][r] & (0x80 >> cc))
              lcd_draw_pixel(x+cc, y+r, color);
      x += 7;
    }
    s++;
  }
}

static void ui_draw_char(uint16_t x, uint16_t y, uint8_t ch, uint16_t color, uint8_t scale) {
  uint8_t idx = ui_font_idx(ch);
  (void)scale;
  static const uint8_t num[4] = {0, 13, 20, 24};
  for (int r = 0; r < 12; r++) {
    uint16_t v = ((uint16_t)font8x12[idx][r*2]<<8) | font8x12[idx][r*2+1];
    for (int cc = 0; cc < 8; cc++) {
      uint8_t lv = (v >> (14-2*cc)) & 3;
      if (lv) lcd_draw_pixel(x+cc, y+r, aa_blend(color, UI_BG, num[lv], 24));
    }
  }
}

/* 8x12 draw text: each char = 9*scale px wide */
static void ui_draw_text(uint16_t x, uint16_t y, const char *s, uint16_t color, uint8_t scale) {
  while (*s) {
    if (*s == '.') {
      /* Small dot at bottom, half-width (4px instead of 9) */
      lcd_fill_rect(x, y+10, x+2*scale-1, y+11*scale, color);
      x += 4 * scale;
    } else {
      ui_draw_char(x, y, (uint8_t)*s, color, scale);
      x += 9 * scale;
    }
    s++;
  }
}


/* Native big font renderer (28x44, batch row writes)
   '.' is rendered as small bottom dot, half-width (14px) */
static void ui_draw_big(int x, int y, const char *str, uint16_t color)
{
  const char *p = str;
  int cx = x;
  while (*p) {
    if (*p == '.') {
      /* Small dot at bottom center, half-width cell */
      lcd_set_window(cx, y+36, cx+13, y+42);
      lcd_cmd(0x2C);
      ILI9488_DCX_HIGH();
      for (int r = 0; r < 7; r++)
        for (int b = 0; b < 14; b++) {
          int dx = b - 7, dy = r - 3;
          lcd_write16((dx*dx + dy*dy <= 9) ? color : UI_BG);
        }
      cx += 14;
    } else {
      int idx = -1;
      for (int i = 0; i < 70; i++) {
        if (" .:+-/()0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"[i] == *p) {
          idx = i; break;
        }
      }
      if (idx >= 0) {
        for (int r = 0; r < 44; r++) {
          uint32_t v = ((uint32_t)fontBig[idx][r*4] << 24) |
                       ((uint32_t)fontBig[idx][r*4+1] << 16) |
                       ((uint32_t)fontBig[idx][r*4+2] << 8) |
                       ((uint32_t)fontBig[idx][r*4+3]);
          lcd_set_window(cx, y+r, cx+27, y+r);
          lcd_cmd(0x2C);
          ILI9488_DCX_HIGH();
          for (int b = 0; b < 28; b++) {
            lcd_write16((v & (1 << (31 - b))) ? color : UI_BG);
          }
        }
      }
      cx += 28;
    }
    p++;
  }
}

/* Draw decimal number (uses 8x12 font) */
static void ui_draw_num(uint16_t x, uint16_t y, uint32_t num, uint16_t color, uint8_t scale) {
  char buf[12];
  uint8_t i = 0, a, b;
  char t;
  if (num == 0) buf[i++] = '0';
  while (num) { buf[i++] = (char)('0' + (num % 10)); num /= 10; }
  for (a = 0, b = i - 1; a < b; a++, b--) { t = buf[a]; buf[a] = buf[b]; buf[b] = t; }
  buf[i] = 0;
  ui_draw_text(x, y, buf, color, scale);
}



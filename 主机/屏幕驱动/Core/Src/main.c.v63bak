/* 12x20 char index mapping */
/* Blend fg toward bg: num/den fraction of fg (RGB565) */
static uint16_t aa_blend(uint16_t fg, uint16_t bg, uint8_t num, uint8_t den) {
  uint8_t fr=(fg>>11)&0x1F, fg6=(fg>>5)&0x3F, fb=fg&0x1F;
  uint8_t br=(bg>>11)&0x1F, bg6=(bg>>5)&0x3F, bb=bg&0x1F;
  uint8_t r=(fr*num+br*(den-num))/den;
  uint8_t g=(fg6*num+bg6*(den-num))/den;
  uint8_t b=(fb*num+bb*(den-num))/den;
  return (uint16_t)((r<<11)|(g<<5)|b);
}

static int ui8_idx(char ch) {
  if (ch == ' ') return 0;
  if (ch == '.') return 1;
  if (ch == ':') return 2;
  if (ch == '+') return 3;
  if (ch == '-') return 4;
  if (ch == '/') return 5;
  if (ch == '(') return 6;
  if (ch == ')') return 7;
  if (ch >= '0' && ch <= '9') return 8 + (ch - '0');
  if (ch >= 'A' && ch <= 'Z') return 18 + (ch - 'A');
  if (ch >= 'a' && ch <= 'z') return 44 + (ch - 'a');
  return 0;
}

/* 12x20 grayscale AA draw char (2bpp, 3 bytes/row), batch */
static void ui8_draw_char(uint16_t x, uint16_t y, char ch, uint16_t color, uint8_t scale) {
  int idx = ui8_idx(ch);
  (void)scale;
  static const uint8_t num[4] = {0, 13, 20, 24};  /* coverage /24, brighter */
  for (int r = 0; r < 20; r++) {
    uint32_t v = ((uint32_t)font12x20[idx][r*3]<<16) |
                 ((uint32_t)font12x20[idx][r*3+1]<<8) |
                 font12x20[idx][r*3+2];
    for (int cc = 0; cc < 12; cc++) {
      uint8_t lv = (v >> (22-2*cc)) & 3;
      if (lv) lcd_draw_pixel(x+cc, y+r, aa_blend(color, UI_BG, num[lv], 24));
    }
  }
}

/* 12x20 draw text: each char = 13*scale px wide */
static void ui8_draw_text(uint16_t x, uint16_t y, const char *s, uint16_t color, uint8_t scale) {
  while (*s) {
    ui8_draw_char(x, y, *s, color, scale);
    x += 13 * scale;
    s++;
  }
}


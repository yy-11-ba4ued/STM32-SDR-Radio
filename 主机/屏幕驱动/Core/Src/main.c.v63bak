/* 8x12 char index (same mapping as ui8_idx) */
static uint8_t ui_font_idx(uint8_t ch) {
  if (ch == ' ') return 0;
  if (ch == '.') return 1;
  if (ch == ':') return 2;
  if (ch == '+') return 3;
  if (ch == '-') return 4;
  if (ch == '/') return 5;
  if (ch == '(') return 6;
  if (ch == ')') return 7;
  if (ch >= '0' && ch <= '9') return 8 + (ch - '0');
  if (ch >= 'A' && ch <= 'Z') return 18 + (ch - 'A');
  if (ch >= 'a' && ch <= 'z') return 44 + (ch - 'a');
  return 0;
}


/* ==================== SDR 电台 UI 主程序 ==================== */

/* ---- UI 布局常量 (480x320) ---- */
#define UI_BG       ILI9488_RGB565(8,10,14)
#define UI_WHITE    ILI9488_RGB565(220,220,220)
#define UI_GREY     ILI9488_RGB565(110,120,130)
#define UI_RED      ILI9488_RGB565(220,50,60)
#define UI_GREEN    ILI9488_RGB565(40,200,80)
#define UI_YELLOW   ILI9488_RGB565(230,200,40)
#define UI_BLUE     ILI9488_RGB565(40,120,220)
#define UI_DARK     ILI9488_RGB565(25,28,35)

/* 频谱/瀑布区 */
#define SP_X0   15
#define SP_X1   465
#define SP_Y0   166
#define SP_DY0  SP_Y0  /* v62: 频谱柱铺满整个白色框(原190=框一半高, 用户指出修正) */
#define SP_Y1   215
#define WF_Y0   230
#define WF_Y1   312
#define SP_W    (SP_X1 - SP_X0 + 1)
#define WF_H    (WF_Y1 - WF_Y0 + 1)

/* ---- UI 状态变量 (后续由上位机/ADC 更新) ---- */
typedef struct {
  uint8_t  rx_mode;
  uint8_t  status;
  uint16_t pwr_w;
  int8_t   gain_db;
  uint16_t temp_c;
  uint8_t  batt_pct;
  uint16_t bat_v;
  uint16_t cur_100ma;
  char     mode[4];
  uint32_t vfo_a_hz;
  uint32_t vfo_b_hz;
  int16_t  xit_khz;
  uint16_t s_level;
  uint16_t swr_val;
  uint8_t  pc_connected;
} UI_State;

static UI_State ui = {
  .rx_mode = 0, .status = 0, .pwr_w = 10, .gain_db = 0,
  .temp_c = 32, .batt_pct = 70, .bat_v = 124, .cur_100ma = 52,
  .mode = "USB", .vfo_a_hz = 14270000, .vfo_b_hz = 7050000,
  .xit_khz = 0, .s_level = 45, .swr_val = 18, .pc_connected = 1
};

static uint32_t ui_rng = 123456789;
static inline uint16_t ui_rand(void) {
  ui_rng = ui_rng * 1664525UL + 1013904223UL;
  return (uint16_t)(ui_rng >> 16);
}

/* 瀑布色阶 */
/* v62: 瀑布色带 —— 蓝->青->黄->红->白(主流 SDR 频谱色带, 无绿色大段;
 * 青色仅作蓝->黄的窄过渡"水色"), 底噪深蓝暗沉, 强信号红->白; RGB565 全位宽。 */
static uint16_t wf_color(uint8_t v) {
  if (v < 32)  return ILI9488_RGB565(0, 0, v*8);                            /* 黑->深蓝 */
  if (v < 80)  { uint8_t t=v-32;  return ILI9488_RGB565(0, t*3, 255); }      /* 深蓝->亮蓝 */
  if (v < 128) { uint8_t t=v-80;  return ILI9488_RGB565(0, 96+t*3, 255); }   /* 亮蓝->青(水色) */
  if (v < 176) { uint8_t t=v-128; return ILI9488_RGB565(t*4, 255, 255-t*2); } /* 青->黄 */
  if (v < 224) { uint8_t t=v-176; return ILI9488_RGB565(255, 255-t*2, 0); }   /* 黄->红 */
  uint8_t t=v-224;
  return ILI9488_RGB565(255, t*2, t*2);                                       /* 红->白 */
}

/* v60: RGB565 全色域渐变 LUT(频谱柱/瀑布共用, 预计算 256 级) ——
 * ILI9488 为 16bit RGB565(65536 色), wf_color 输出即全位宽渐变。 */
static uint16_t wf_col_lut[256];
static void wf_color_lut_init(void) {
    for (int i = 0; i < 256; i++) wf_col_lut[i] = wf_color((uint8_t)i);
}

/* v62: 频谱柱专用白色 LUT —— 频谱图只显示白色(亮度随强度渐增: 底噪暗白, 强信号纯白),
 * 瀑布图才用彩色色带; 与 wf_col_lut 分离。 */
static uint16_t sp_col_lut[256];
static void sp_col_lut_init(void) {
    for (int i = 0; i < 256; i++) {
        uint8_t w = (uint8_t)i;
        sp_col_lut[i] = ILI9488_RGB565(w, w, w);
    }
}

/* 频率数字格式化: 14270000 -> "14.270.000" */
static void fmt_freq(uint32_t hz, char *out) {
  uint32_t mhz = hz / 1000000;
  uint32_t khz = (hz / 1000) % 1000;
  uint32_t hz_ = hz % 1000;
  out[0] = '0' + (mhz/10); out[1] = '0' + (mhz%10);
  out[2] = '.';
  out[3] = '0' + (khz/100); out[4] = '0' + ((khz/10)%10); out[5] = '0' + (khz%10);
  out[6] = '.';
  out[7] = '0' + (hz_/100); out[8] = '0' + ((hz_/10)%10); out[9] = '0' + (hz_%10);
  out[10] = 0;
}

/* 画静态元素 (所有边框/标签/固定文字只画一次, 不随帧重画) */
/* ==================== Sideband indicator (42x17, 1bpp) ====================
   Source icon is USB (upper sideband): baseline along bottom row, vertical
   stem at col20, right trapezoid ABOVE the baseline.
   mode 0=USB(upper) 1=LSB(lower, vertical flip) 2=DSB(both, AM/FM/CW)
   (x, baseY) = left edge and screen Y of the horizontal baseline (source row16). */
#define SB_USB 0
#define SB_LSB 1
#define SB_DSB 2
static const uint8_t sideband_bits[17][6] = {
  {0x00,0x00,0x08,0x00,0x00,0x00},
  {0x00,0x00,0x08,0x00,0x00,0x00},
  {0x00,0x00,0x08,0x00,0x00,0x00},
  {0x00,0x00,0x08,0x00,0x00,0x00},
  {0x00,0x00,0x0F,0xE0,0x00,0x00},
  {0x00,0x00,0x0F,0xF0,0x00,0x00},
  {0x00,0x00,0x0F,0xF8,0x00,0x00},
  {0x00,0x00,0x0F,0xF8,0x00,0x00},
  {0x00,0x00,0x0F,0xFC,0x00,0x00},
  {0x00,0x00,0x0F,0xFE,0x00,0x00},
  {0x00,0x00,0x0F,0xFE,0x00,0x00},
  {0x00,0x00,0x0F,0xFF,0x00,0x00},
  {0x00,0x00,0x0F,0xFF,0x00,0x00},
  {0x00,0x00,0x0F,0xFF,0x80,0x00},
  {0x00,0x00,0x0F,0xFF,0xC0,0x00},
  {0x00,0x00,0x0F,0xFF,0xC0,0x00},
  {0xFF,0xFF,0xFF,0xFF,0xFF,0xC0}
};
static void ui_draw_sideband(int x, int baseY, uint16_t color, int mode) {
  /* Mini-spectrum: symmetric baseline, carrier stem fixed at x+20, trapezoid
     above baseline. USB = trapezoid RIGHT of carrier, LSB = LEFT (mirror about
     the stem col20 so it never shifts), DSB = both sides (stem overlaps, 1px). */
  int stem = 20;
  /* rows 0..15: stem + trapezoid above the baseline */
  for (int r = 0; r < 16; r++) {
    int sy = baseY - 16 + r;
    for (int cc = 0; cc < 42; cc++) {
      if (!(sideband_bits[r][cc/8] & (0x80 >> (cc%8)))) continue;
      if (mode == SB_USB || mode == SB_DSB)
        lcd_draw_pixel(x+cc, sy, color);                  /* right side (USB) */
      if (mode == SB_LSB || mode == SB_DSB)
        lcd_draw_pixel(x+2*stem-cc, sy, color);           /* mirror about stem */
    }
  }
  /* symmetric baseline (41px, 20 each side) and 1px carrier stem */
  lcd_fill_rect(x, baseY, x+2*stem, baseY, color);
  lcd_fill_rect(x+stem, baseY-16, x+stem, baseY, color);
}


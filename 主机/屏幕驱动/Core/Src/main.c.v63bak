/* ==================== USART2 UI Designer Command Interface ==================== */
uint8_t uart2_rx_byte;
volatile uint8_t uart2_rx_ready = 0;
static char uart2_rx_buf[128];
static uint8_t uart2_rx_idx = 0;

/* Layout overrides from designer */
static int16_t layout_x[32];
static int16_t layout_y[32];
static uint8_t layout_dirty = 0;

void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart) {
  if (huart->Instance == USART2) {
    uint8_t ch = uart2_rx_byte;
    if (ch == '\n' || ch == '\r') {
      if (uart2_rx_idx > 0) {
        uart2_rx_buf[uart2_rx_idx] = 0;
        uart2_rx_ready = 1;
        uart2_rx_idx = 0;
      }
    } else {
      if (uart2_rx_idx < sizeof(uart2_rx_buf)-1) {
        uart2_rx_buf[uart2_rx_idx++] = ch;
      } else {
        uart2_rx_idx = 0;
      }
    }
    HAL_UART_Receive_IT(&huart2, &uart2_rx_byte, 1);
  }
}

void USART2_IRQHandler(void) {
  HAL_UART_IRQHandler(&huart2);
}

void ui_designer_process(void) {
  if (!uart2_rx_ready) return;
  uart2_rx_ready = 0;
  char *buf = uart2_rx_buf;
  /* Reply */
  char reply[64];
  int n;

  if (strncmp(buf, "PING", 4) == 0) {
    n = snprintf(reply, sizeof reply, "PONG\n");
    HAL_UART_Transmit(&huart2, (uint8_t*)reply, n, 100);
  } else if (strncmp(buf, "REDRAW", 6) == 0) {
    ui_draw_static();
    n = snprintf(reply, sizeof reply, "OK\n");
    HAL_UART_Transmit(&huart2, (uint8_t*)reply, n, 100);
  } else if (strncmp(buf, "POS,", 4) == 0) {
    /* POS,id,x,y - just acknowledge for now */
    n = snprintf(reply, sizeof reply, "OK\n");
    HAL_UART_Transmit(&huart2, (uint8_t*)reply, n, 100);
  } else if (strncmp(buf, "FILL,", 5) == 0) {
    /* v63-上位机: 全屏填充测试色 FILL,r,g,b (0-255) - 验证上位机->主机->屏幕链路。
     * 频谱/瀑布区会被主循环频谱绘制覆盖, 其余区域保持填充色; CLR 恢复界面。 */
    int r = 0, g = 0, b = 0;
    if (sscanf(buf + 5, "%d,%d,%d", &r, &g, &b) >= 1) {
      if (r < 0) r = 0; if (r > 255) r = 255;
      if (g < 0) g = 0; if (g > 255) g = 255;
      if (b < 0) b = 0; if (b > 255) b = 255;
      lcd_fill_rect(0, 0, 479, 319, ILI9488_RGB565((uint8_t)r, (uint8_t)g, (uint8_t)b));
      n = snprintf(reply, sizeof reply, "OK FILL %d,%d,%d\n", r, g, b);
    } else n = snprintf(reply, sizeof reply, "ERR FILL\n");
    HAL_UART_Transmit(&huart2, (uint8_t*)reply, n, 100);
  } else if (strncmp(buf, "TXT,", 4) == 0) {
    /* v63-上位机: 屏幕显示文字 TXT,x,y,scale,text (scale 1-3, ASCII) */
    int x = 0, y = 0, sc = 1;
    char txt[64]; txt[0] = 0;
    if (sscanf(buf + 4, "%d,%d,%d,%63[^\n\r]", &x, &y, &sc, txt) >= 3) {
      if (sc < 1) sc = 1; if (sc > 3) sc = 3;
      if (x < 0) x = 0; if (x > 460) x = 460;
      if (y < 0) y = 0; if (y > 300) y = 300;
      ui_draw_text((uint16_t)x, (uint16_t)y, txt, ILI9488_RGB565(255,255,255), (uint8_t)sc);
      n = snprintf(reply, sizeof reply, "OK TXT\n");
    } else n = snprintf(reply, sizeof reply, "ERR TXT\n");
    HAL_UART_Transmit(&huart2, (uint8_t*)reply, n, 100);
  } else if (strncmp(buf, "CLR", 3) == 0) {
    /* v63-上位机: 恢复频谱界面(重绘静态 UI, 频谱循环自动恢复) */
    ui_draw_static();
    n = snprintf(reply, sizeof reply, "OK\n");
    HAL_UART_Transmit(&huart2, (uint8_t*)reply, n, 100);
  }
}

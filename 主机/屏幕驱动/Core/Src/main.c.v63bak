/* USART2 receive byte (defined at file tail), declared early so main() can arm HAL receive */
extern uint8_t uart2_rx_byte;

/* ========== SPI3 master: read spectrum from slave MCU ==========
 * PB2=MOSI(dummy out, AF7), PC10=SCK(out, AF6), PC11=MISO(in, AF6),
 * PA15=NSS(out, soft). Master, 8-bit, Mode 0, prescaler 256. */
static SPI_HandleTypeDef hspi3;

static void MX_SPI3_Init(void)
{
    __HAL_RCC_SPI3_CLK_ENABLE();
    __HAL_RCC_GPIOB_CLK_ENABLE(); __HAL_RCC_GPIOC_CLK_ENABLE(); __HAL_RCC_GPIOA_CLK_ENABLE();
    /* v28: PA15 = SPI3_NSS(AF6) 复用脚, 复位后虽默认 AF0_SWJ(JTDI),
     * 但 GPIO 寄存器可重新配置, 这里配置为 GPIO 输出做软件 NSS (快路径) */
    GPIO_InitTypeDef g = {0};
    g.Pin = GPIO_PIN_15; g.Mode = GPIO_MODE_OUTPUT_PP; g.Pull = GPIO_NOPULL; g.Speed = GPIO_SPEED_FREQ_HIGH;
    HAL_GPIO_Init(GPIOA, &g); HAL_GPIO_WritePin(GPIOA, GPIO_PIN_15, GPIO_PIN_SET);
    /* SCK=PC10 AF6, MISO=PC11 AF6, MOSI=PB2 AF7 */
    g.Pin = GPIO_PIN_10 | GPIO_PIN_11; g.Mode = GPIO_MODE_AF_PP; g.Pull = GPIO_PULLUP; g.Speed = GPIO_SPEED_FREQ_HIGH; g.Alternate = GPIO_AF6_SPI3;   /* v33: PC11(MISO)输入上拉, 从机间隙高阻时空闲电平固定为高 */
    HAL_GPIO_Init(GPIOC, &g);
    g.Pin = GPIO_PIN_2; g.Pull = GPIO_PULLDOWN; g.Alternate = GPIO_AF7_SPI3;   /* v34: MOSI 下拉, RXONLY 不驱动时固定低(防浮空漂移) */
    HAL_GPIO_Init(GPIOB, &g);
    /* SPI3 Master config */
    hspi3.Instance = SPI3;
    hspi3.Init.Mode = SPI_MODE_MASTER;
    hspi3.Init.Direction = SPI_DIRECTION_2LINES;   /* v35: 全双工(W25Q64示例板级验证读法): 发 0xFF 触发 SCK + 收 MISO; RXONLY 实测解不出 */
    hspi3.Init.DataSize = SPI_DATASIZE_8BIT;
    hspi3.Init.CLKPolarity = SPI_POLARITY_LOW;
    hspi3.Init.CLKPhase = SPI_PHASE_1EDGE;
    hspi3.Init.NSS = SPI_NSS_SOFT;
    hspi3.Init.BaudRatePrescaler = SPI_BAUDRATEPRESCALER_8;   /* v51-DIAG: 15M->3.75M 降速诊断(验证总线竞争假说: 补数窗口0.53->2.13us, CPU不再忙/DMA优先); 确认后恢复高速+优化 */
    hspi3.Init.FirstBit = SPI_FIRSTBIT_MSB;
    hspi3.Init.TIMode = SPI_TIMODE_DISABLE;
    hspi3.Init.CRCCalculation = SPI_CRCCALCULATION_DISABLE;
    hspi3.Init.NSSPolarity = SPI_NSS_POLARITY_LOW;
    hspi3.Init.FifoThreshold = SPI_FIFO_THRESHOLD_01DATA;
    HAL_SPI_Init(&hspi3);
    __HAL_SPI_ENABLE(&hspi3);  /* force enable */
}

/* 4096-point FFT length; must match slave frame data length (4096 x int16) ——
   v60: 2048->4096, 频率分辨率 1832->916 Hz/bin(与从机 RX_FRAME_N 同步) */
#define FFT_N 4096
/* v43: 从机 v31.45 实测连续模式采样率(FSAMP fs=3752605) 与频谱横轴上限 0-600kHz。
   fft_apply 按此对位: 屏幕右端柱=600kHz, 100kHz 峰显示在 100k 刻度处。 */
#define ADC_FS     3752605UL
#define SP_FMAX_HZ 600000UL
/* v60: 0-1V(峰-峰) 满量程对数基准 —— 1V = 4095*1/3.3/2 = 620.45LSB 峰幅,
   FFT 峰 = 620.45/2*N*0.5(汉宁) = 310.23*N*0.5 (N=4096 -> 6.354e5 = 0dB) */
#define MAG_1V     (310.23f * (float)FFT_N * 0.5f)

/* Read one frame from the slave.
 * Frame format AA 5A seq len_lo len_hi data[4096].
 * v28 dual-path:
 *  - fast path: pull NSS low so the slave starts at its frame head, then read
 *    and validate the 5-byte header.
 *  - fallback: if NSS is unusable (or the slave was not ready), byte-by-byte
 *    header sync (state machine looking for AA 5A) over the continuous stream.
 * The ADC payload is int16 little-endian (odd bytes 0x00..0x0F), so a literal
 * AA 5A cannot occur inside the data -> sync is deterministic.
 * Returns 1 with a full frame, 0 on sync failure (UI falls back to noise). */
/* v31.4 单向模式: 主机 SPI3 master RXONLY (CFG2.COMM=01), MOSI 不输出,
 * SCK 由 TSIZE + CSTART 自动产生 (H7 主模式 RXONLY: 设 TSIZE 后置 CSTART,
 * 硬件自动产生 TSIZE 个 SCK, 不需要写 TXDR)。每段读前清残留标志。
 * 每字节等 RXP -> 读 RXDR; per_byte_ms 每字节超时。 */
static int spi_master_read(uint8_t *buf, uint32_t n, uint32_t per_byte_ms)
{
    /* v35: 全双工手动读, 仿 W25Q64 示例(H750 板级验证) MY_SPI_TransmitReceive:
     *   TSIZE=0(不用硬件长度限制) -> enable -> CSTART ->
     *   循环: TXP 写 0xFF 产生 SCK; RXP 读 RXDR; 无进展超时 per_byte_ms ->
     *   CSUSP 手动结束传输。
     * 根因: 官方 HAL_SPI_TransmitReceive 大数据读取有偏位 bug(示例作者自写绕开);
     *       RXONLY+TSIZE 路径实测 SCK 正常但数据解不出。全双工+发0xFF 才是验证读法。
     * 兼容从机: 从机 v31.9 = 2LINES + HAL_SPI_Transmit(HAL 内部切 TX-only),
     *           主机 0xFF 进从机 RX 但从机 RX 关闭, 无 OVR; 按 SCK 移出数据。 */
    __HAL_SPI_DISABLE(&hspi3);
    SPI3->IFCR = SPI_IFCR_UDRC | SPI_IFCR_EOTC | SPI_IFCR_OVRC | SPI_IFCR_TXTFC | SPI_IFCR_SUSPC;
    MODIFY_REG(SPI3->CR2, SPI_CR2_TSIZE, 0);   /* 硬件 TSIZE 不限制, 手动控制收发 */
    __HAL_SPI_ENABLE(&hspi3);
    SET_BIT(SPI3->CR1, SPI_CR1_CSTART);        /* master transfer start */
    uint32_t i = 0;
    uint32_t last_act = HAL_GetTick();
    while (i < n)
    {
        if (SPI3->SR & SPI_SR_TXP) {
            *((volatile uint8_t *)&SPI3->TXDR) = 0xFF;   /* 发0xFF产生SCK */
            last_act = HAL_GetTick();
        }
        if (SPI3->SR & SPI_SR_RXP) {
            buf[i] = (uint8_t)(*((volatile uint8_t *)&SPI3->RXDR));
            i++;
            last_act = HAL_GetTick();
        }
        if ((HAL_GetTick() - last_act) > per_byte_ms) break;   /* 无进展超时(宽容从机间隙) */
    }
    SET_BIT(SPI3->CR1, SPI_CR1_CSUSP);         /* 手动结束传输 */
    SPI3->IFCR = SPI_IFCR_SUSPC;
    if (i < n) { __HAL_SPI_DISABLE(&hspi3); return 0; }
    return 1;
}

static uint8_t spi_scan[2 * (5 + 2 * FFT_N) + 5];  /* v33: 2帧+5B冗余, 帧头不会落在搜索窗口外 */

static uint8_t spi_rx_frame(uint8_t *hdr, uint8_t *data, uint16_t maxlen)
{
    /* v60: 一次读满 2 帧量 (16402B), 滚动搜帧头 -> 同步快且稳。
     * 旧版(v31.5) 读5B快路径失败后逐字节搜, 每字节一次 disable/enable 事务,
     * 从机帧间 disable 窗口时 RXP 不置位 -> 50ms 超时整轮早退, 多轮累积
     * 导致数十秒才同步上(用户实测)。新版 SCK 连续 16402 个, 帧间间隙(µs级)
     * 不触发 20ms 超时, buffer 内必含完整一帧, 帧头只在 0..4101 滑动窗口内。 */
    if (!(SPI3->CR1 & SPI_CR1_SPE)) { __HAL_SPI_ENABLE(&hspi3); }
    HAL_GPIO_WritePin(GPIOA, GPIO_PIN_15, GPIO_PIN_RESET);
    HAL_Delay(1);   /* v38: NSS 低后延迟 1ms, 给从机同步到 SCK 域的时间, 消除 55<->AA 相位错位 */
    uint8_t ok = spi_master_read(spi_scan, sizeof(spi_scan), 100);   /* v45: 流式后无长间隙, 100ms 足够; 从机掉线时快速恢复(原300ms) */
    HAL_GPIO_WritePin(GPIOA, GPIO_PIN_15, GPIO_PIN_SET);
    HAL_Delay(2);    /* v44: NSS 高窗口 20ms->2ms(从机武装检测/写TSIZE 为us级, 2ms充足), 每轮省18ms */
    if (!ok) return 0;                       /* 从机间隙 >20ms 或未响应: 下轮重试 */
    uint32_t win  = 5u + 2u * FFT_N;         /* 一帧长 4101B */
    uint32_t last = sizeof(spi_scan) - win;  /* 帧头可能位置 0..4101 */
    for (uint32_t i = 0; i <= last; i++)
    {
        if (spi_scan[i] == 0xAA && spi_scan[i + 1] == 0x5A &&
            spi_scan[i + 3] == (uint8_t)(FFT_N & 0xFF) &&
            spi_scan[i + 4] == (uint8_t)((FFT_N >> 8) & 0xFF))
        {
            memcpy(hdr,  spi_scan + i, 5);
            memcpy(data, spi_scan + i + 5, maxlen);
            return 1;
        }
    }
    return 0;                                /* buffer 内无完整帧: 下轮重试 */
}

/* ---- Simple 2048-point real FFT with Hann window ---- */
static float fft_re[FFT_N], fft_im[FFT_N];
static float hann_win[FFT_N];
static int hann_inited = 0;

static void fft_init(void) {
    for (int i = 0; i < FFT_N; i++) {
        hann_win[i] = 0.5f * (1.0f - cosf(2.0f * 3.14159265f * i / (FFT_N - 1)));
    }
    hann_inited = 1;
}

static uint8_t fft_apply(int16_t *input, uint8_t *output, int out_n) {   /* v51: 返回0=泄漏帧(底噪全场抬升) */
    if (!hann_inited) fft_init();
    /* v45b: 减实际均值(原 v25 减固定 2048) —— ADC 实际基线 1706(无信号)/2045(有信号),
     * 固定减法残留 DC 使 0Hz 柱随帧间基线抖动闪烁; 减均值后 DC 主瓣消失。 */
    long long dcsum = 0;
    for (int i = 0; i < FFT_N; i++) dcsum += input[i];
    float dcmean = (float)dcsum / (float)FFT_N;
    for (int i = 0; i < FFT_N; i++) {
        fft_re[i] = ((float)input[i] - dcmean) * hann_win[i];
        fft_im[i] = 0.0f;
    }
    /* v30(FFT 修复): DIT FFT 必须先做位反转输入重排, 否则输出 bin 顺序错乱
     * (此前频率轴折叠: 100kHz 峰显示在 400kHz 处, 频谱全错)。用 numpy 对照验证:
     * 加位反转后 150kHz 正弦 -> FFT bin 256 -> 显示柱 x=113, 其余柱为 0 */
    {
        uint16_t br_j = 0;
        for (uint16_t br_i = 1; br_i < FFT_N; br_i++) {
            uint16_t bit = (uint16_t)(FFT_N >> 1);
            while (br_j & bit) { br_j ^= bit; bit >>= 1; }
            br_j ^= bit;
            if (br_i < br_j) {
                float tr = fft_re[br_i]; fft_re[br_i] = fft_re[br_j]; fft_re[br_j] = tr;
                float ti = fft_im[br_i]; fft_im[br_i] = fft_im[br_j]; fft_im[br_j] = ti;
            }
        }
    }
    for (int len = 2; len <= FFT_N; len <<= 1) {
        float ang = -2.0f * 3.14159265f / len;
        float wpr = cosf(ang), wpi = sinf(ang);
        for (int i = 0; i < FFT_N; i += len) {
            float wr = 1.0f, wi = 0.0f;
            for (int j = 0; j < len/2; j++) {
                float ur = fft_re[i+j], ui = fft_im[i+j];
                float vr = fft_re[i+j+len/2] * wr - fft_im[i+j+len/2] * wi;
                float vi = fft_re[i+j+len/2] * wi + fft_im[i+j+len/2] * wr;
                fft_re[i+j] = ur + vr;
                fft_im[i+j] = ui + vi;
                fft_re[i+j+len/2] = ur - vr;
                fft_im[i+j+len/2] = ui - vi;
                float twr = wr * wpr - wi * wpi;
                wi = wr * wpi + wi * wpr;
                wr = twr;
            }
        }
    }
    /* v25: relative dB mapping: peak = 45 bars, 40 dB dynamic range.
     * Avoids the old mag/200 cap that pinned every strong tone at full scale. */
    static float mags[512];   /* v25fix: 2KB 数组放 .bss, 避免 1KB 栈溢出(HardFault 屏幕半亮) */
    /* v60: 固定 0-1V(峰-峰) 满量程对数刻度 ——
     * 1V(620.45LSB 峰幅) FFT 峰 = 620.45/2*N*0.5(汉宁) = 6.354e5(N=4096) = 0dB;
     * 动态 100dB: 底噪(σ~3LSB)≈-76.6dB -> 柱 ~60/255 底部起伏, 强信号不再压没底噪。 */
    for (int x = 0; x < out_n; x++) {
        /* v43: 横轴对位实测采样率 —— 屏幕右端柱=600kHz。
         * 柱 x 频率 = x*Fmax/out_n, FFT bin = f*N/Fs
         * -> idx = x*Fmax*N/(Fs*out_n) (64 位中间量防截断) */
        int idx = (int)(((unsigned long long)x * SP_FMAX_HZ * FFT_N)
                        / ((unsigned long long)ADC_FS * (unsigned)out_n));
        float mag = sqrtf(fft_re[idx]*fft_re[idx] + fft_im[idx]*fft_im[idx]);
        if (idx == 0) mag = 0.0f;   /* v45: 0Hz=DC bin 抑制 */
        mags[x] = mag;
    }
    for (int x = 0; x < out_n; x++) {
        float db_rel = 20.0f * log10f(mags[x] / MAG_1V);
        if (db_rel > 0.0f) db_rel = 0.0f;
        if (db_rel < -80.0f) db_rel = -80.0f;
        uint8_t v = (uint8_t)(255.0f * (db_rel + 80.0f) / 80.0f);   /* v61: 动态100->80dB, 底噪贴底(约4%柱) */
        if (v < 3) v = 3;   /* v41: 底噪底线 */
        output[x] = v;
    }
    /* v59: 泄漏检测(wide>8)与坏帧计数已移除 —— 泄漏根治后每帧直接刷新。 */
    return 1;
}

/* USER CODE END 0 */

/**
  * @brief  The application entry point.
  * @retval int
  */
static void lcd_debug_print(void);

/* 写 16 位 via FMC - DCX level by GPIO (same as working GPIO driver) */
static inline void lcd_write16(uint16_t v)
{
  *LCD_FMC_ADDR = v;
  __DSB();
}

static inline void lcd_cmd(uint16_t c)  { ILI9488_DCX_LOW();  __DSB(); lcd_write16(c); }
static inline void lcd_data(uint16_t d) { ILI9488_DCX_HIGH(); __DSB(); lcd_write16(d); }

static void lcd_cmd_params(uint16_t cmd, const uint16_t *p, uint32_t len)
{
  uint32_t i;
  lcd_cmd(cmd);
  for (i = 0; i < len; i++) lcd_data(p[i]);
}
/* Configure MPU to make FMC region (0x60000000) Device memory.
 * This prevents CPU from reordering/merging writes to FMC, which causes
 * spurious write cycles on the 8080 bus. */
static void MPU_Config_FMC(void)
{
  MPU_Region_InitTypeDef MPU_InitStruct = {0};

  HAL_MPU_Disable();

  /* Configure FMC Bank1 (0x60000000, 64MB) as Device non-cacheable */
  MPU_InitStruct.Enable = MPU_REGION_ENABLE;
  MPU_InitStruct.Number = MPU_REGION_NUMBER0;
  MPU_InitStruct.BaseAddress = 0x60000000;
  MPU_InitStruct.Size = MPU_REGION_SIZE_64MB;
  MPU_InitStruct.SubRegionDisable = 0x00;
  MPU_InitStruct.TypeExtField = MPU_TEX_LEVEL0;
  MPU_InitStruct.AccessPermission = MPU_REGION_FULL_ACCESS;
  MPU_InitStruct.DisableExec = MPU_INSTRUCTION_ACCESS_DISABLE;
  MPU_InitStruct.IsShareable = MPU_ACCESS_NOT_SHAREABLE;
  MPU_InitStruct.IsCacheable = MPU_ACCESS_NOT_CACHEABLE;
  MPU_InitStruct.IsBufferable = MPU_ACCESS_NOT_BUFFERABLE;

  HAL_MPU_ConfigRegion(&MPU_InitStruct);
  HAL_MPU_Enable(MPU_PRIVILEGED_DEFAULT);
}

int main(void)
{

  /* USER CODE BEGIN 1 */
  MPU_Config_FMC();  /* FMC region as Device memory - must be before any FMC access */
  /* USER CODE END 1 */

  /* Enable the CPU Cache */

  /* Enable I-Cache---------------------------------------------------------*/
  SCB_EnableICache();

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* Configure the peripherals common clocks */
  PeriphCommonClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_DMA_Init();
  MX_BDMA_Init();
  MX_CRC_Init();
  MX_ADC1_Init();
  MX_DAC1_Init();
  MX_TIM2_Init();
  MX_ADC2_Init();
  MX_TIM6_Init();
  MX_ADC3_Init();
  MX_USART2_UART_Init();
  MX_FMC_Init();
  /* USER CODE BEGIN 2 */
  lcd_init();
  HAL_Delay(500);  /* v25: 上电延时, 等从机 boot 完成并进入"等 NSS"状态 */
  MX_SPI3_Init();  /* SPI3 master: read spectrum from slave */
  /* v-fix: 用 HAL_UART_Receive_IT 正常挂接收: 无接收时不触发 RXNE,
     PA3 悬空(无上拉)也不会因噪声字节进 ISR 风暴; 每个字节经 RxCpltCallback 处理后再挂接 */
  HAL_UART_Receive_IT(&huart2, &uart2_rx_byte, 1);
  HAL_NVIC_SetPriority(USART2_IRQn, 5, 0);
  HAL_NVIC_EnableIRQ(USART2_IRQn);

  /* Debug print */
  {
    char buf[256];
    int n;
    uint32_t bcr1 = *(volatile uint32_t *)0x52004000UL;
    uint32_t btr1 = *(volatile uint32_t *)0x52004004UL;
    uint32_t sr1  = *(volatile uint32_t *)0x52004040UL;
    uint32_t ahb3enr = RCC->AHB3ENR;
    n = snprintf(buf, sizeof buf, "DBG FMC BCR1=0x%08lX BTR1=0x%08lX SR1=0x%08lX\r\n",
        (unsigned long)bcr1, (unsigned long)btr1, (unsigned long)sr1);
    HAL_UART_Transmit(&huart2, (uint8_t *)buf, n, 100);
    n = snprintf(buf, sizeof buf, "DBG RCC AHB3ENR=0x%08lX\r\n", (unsigned long)ahb3enr);
    HAL_UART_Transmit(&huart2, (uint8_t *)buf, n, 100);
    n = snprintf(buf, sizeof buf, "DBG GPIOD MODER=0x%08lX AFRH=0x%08lX AFRL=0x%08lX\r\n",
        (unsigned long)GPIOD->MODER, (unsigned long)GPIOD->AFR[1], (unsigned long)GPIOD->AFR[0]);
    HAL_UART_Transmit(&huart2, (uint8_t *)buf, n, 100);
    n = snprintf(buf, sizeof buf, "DBG GPIOE MODER=0x%08lX AFRH=0x%08lX\r\n",
        (unsigned long)GPIOE->MODER, (unsigned long)GPIOE->AFR[1]);
    HAL_UART_Transmit(&huart2, (uint8_t *)buf, n, 100);
    n = snprintf(buf, sizeof buf, "DBG GPIOC MODER=0x%08lX AFRL=0x%08lX\r\n",
        (unsigned long)GPIOC->MODER, (unsigned long)GPIOC->AFR[0]);
    HAL_UART_Transmit(&huart2, (uint8_t *)buf, n, 100);
  }

  /* Debug: print MPU registers to verify MPU is enabled */
  {
    char buf[256];
    int n;
    uint32_t mpu_ctrl = *(volatile uint32_t *)0xE000ED94UL;
    uint32_t mpu_rnr  = *(volatile uint32_t *)0xE000ED98UL;
    uint32_t mpu_rbar = *(volatile uint32_t *)0xE000ED9CUL;
    uint32_t mpu_rasr = *(volatile uint32_t *)0xE000EDA0UL;
    n = snprintf(buf, sizeof buf, "DBG MPU CTRL=0x%08lX RNR=0x%08lX RBAR=0x%08lX RASR=0x%08lX\r\n",
        (unsigned long)mpu_ctrl, (unsigned long)mpu_rnr, (unsigned long)mpu_rbar, (unsigned long)mpu_rasr);
    HAL_UART_Transmit(&huart2, (uint8_t *)buf, n, 100);
  }

  /* ==================== SDR 电台主 UI ==================== */
  ui_main();
}

/**
  * @brief System Clock Configuration
  * @retval None
  */
void SystemClock_Config(void)
{
  RCC_OscInitTypeDef RCC_OscInitStruct = {0};
  RCC_ClkInitTypeDef RCC_ClkInitStruct = {0};

  /** Supply configuration update enable
  */
  HAL_PWREx_ConfigSupply(PWR_LDO_SUPPLY);

  /** Configure the main internal regulator output voltage
  */
  __HAL_PWR_VOLTAGESCALING_CONFIG(PWR_REGULATOR_VOLTAGE_SCALE0);

  while(!__HAL_PWR_GET_FLAG(PWR_FLAG_VOSRDY)) {}

  /** Initializes the RCC Oscillators according to the specified parameters
  * in the RCC_OscInitTypeDef structure.
  */
  RCC_OscInitStruct.OscillatorType = RCC_OSCILLATORTYPE_HSE;
  RCC_OscInitStruct.HSEState = RCC_HSE_ON;
  RCC_OscInitStruct.PLL.PLLState = RCC_PLL_ON;
  RCC_OscInitStruct.PLL.PLLSource = RCC_PLLSOURCE_HSE;
  RCC_OscInitStruct.PLL.PLLM = 5;
  RCC_OscInitStruct.PLL.PLLN = 192;
  RCC_OscInitStruct.PLL.PLLP = 2;
  RCC_OscInitStruct.PLL.PLLQ = 4;
  RCC_OscInitStruct.PLL.PLLR = 2;
  RCC_OscInitStruct.PLL.PLLRGE = RCC_PLL1VCIRANGE_2;
  RCC_OscInitStruct.PLL.PLLVCOSEL = RCC_PLL1VCOWIDE;
  RCC_OscInitStruct.PLL.PLLFRACN = 0;
  if (HAL_RCC_OscConfig(&RCC_OscInitStruct) != HAL_OK)
  {
    Error_Handler();
  }

  /** Initializes the CPU, AHB and APB buses clocks
  */
  RCC_ClkInitStruct.ClockType = RCC_CLOCKTYPE_HCLK|RCC_CLOCKTYPE_SYSCLK
                              |RCC_CLOCKTYPE_PCLK1|RCC_CLOCKTYPE_PCLK2
                              |RCC_CLOCKTYPE_D3PCLK1|RCC_CLOCKTYPE_D1PCLK1;
  RCC_ClkInitStruct.SYSCLKSource = RCC_SYSCLKSOURCE_PLLCLK;
  RCC_ClkInitStruct.SYSCLKDivider = RCC_SYSCLK_DIV1;
  RCC_ClkInitStruct.AHBCLKDivider = RCC_HCLK_DIV2;
  RCC_ClkInitStruct.APB3CLKDivider = RCC_APB3_DIV2;
  RCC_ClkInitStruct.APB1CLKDivider = RCC_APB1_DIV2;
  RCC_ClkInitStruct.APB2CLKDivider = RCC_APB2_DIV2;
  RCC_ClkInitStruct.APB4CLKDivider = RCC_APB4_DIV2;

  if (HAL_RCC_ClockConfig(&RCC_ClkInitStruct, FLASH_LATENCY_4) != HAL_OK)
  {
    Error_Handler();
  }
}

